{
  "name": "instant-interiors",
  "private": true,
  "description": "Walk through a floor plan and change it by talking: furniture, finishes and light in plain English.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port ${PORT:-3092}",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "shoot": "node scripts/shoot.mjs",
    "qa": "node scripts/qa.mjs",
    "check:kit": "node scripts/kit-check.mjs",
    "check:render": "node scripts/render-check.mjs",
    "draw:plans": "node scripts/draw-plan.mjs",
    "bench:extract": "node --env-file=.env scripts/bench-extract.mjs",
    "bench:intent": "node --env-file=.env bench/intent.ts"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.0",
    "@iconify-json/lucide": "^1.2.134",
    "@nuxt/ui": "^4.12.0",
    "ai": "^7.0.68",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "zod": "^4.4.3"
  }
}
